# Server-only. Set the same names in the Vercel project (Production + Preview).
# Do not prefix with NEXT_PUBLIC_.
LAMBDA_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
LAMBDA_API_KEY=the-same-key-as-mizo-asr-bridge
ASR_ADMIN_URL=http://127.0.0.1:8101
ASR_ADMIN_API_KEY=the-same-key-as-asr-tool-PUBLIC_CONTRIBUTE_API_KEY

# optional: lus or hmr : default is "lus"
NEXT_PUBLIC_LANGUAGE=lus

# optional again
NEXT_PUBLIC_LANGUAGE_DISPLAY_NAME=Mizo